{
  "name": "devforge",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/*.test.ts",
    "browser:test": "node scripts_browser_smoke.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "*",
    "express": "*",
    "lucide-react": "*",
    "monaco-editor": "*",
    "pyodide": "*",
    "react": "*",
    "react-dom": "*",
    "react-router-dom": "*",
    "sql.js": "*"
  },
  "devDependencies": {
    "@types/express": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "concurrently": "*",
    "playwright": "^1.64.1",
    "tsx": "*",
    "typescript": "*",
    "vite": "*"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
